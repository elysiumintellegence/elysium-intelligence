# ─────────────────────────────────────────────
# Elysium Intelligence — Environment Variables
# Copy this file to .env and fill in values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# Database (required)
# Full PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/elysium_dev

# Session secret (required)
# Min 32 characters, random string
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_at_least_32_character_random_string

# Application environment
NODE_ENV=development

# Server port (set automatically by Replit; override locally if needed)
# PORT=5000

# Frontend base path (set automatically by Replit)
# BASE_PATH=/
